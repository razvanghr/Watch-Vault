{
    "compilerOptions": {
      "target": "es6",
      "module": "commonjs",
      "jsx": "react",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "outDir": "./dist"
    },
    "include": [
    "src/**/*", 
    "src/images.d.ts"
  ],
    "exclude": ["node_modules", "**/*.spec.ts"]
  }
  